                  "$ref": "#/$defs/active_webhook"
                }
              }
            },
            "stream_destroyed": {
              "type": "object",
              "properties": {
                "address": {
                  "type": "string",
                  "description": "The URL that Vonage sends events when a stream is destroyed"
                },
                "active": {
                  "$ref": "#/$defs/active_webhook"
                }
              }
