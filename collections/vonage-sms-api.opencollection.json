{
  "opencollection": "1.0.0",
  "info": {
    "name": "Vonage Communications Applications SMS API",
    "version": "1.0.0"
  },
  "request": {
    "auth": {
      "type": "basic",
      "username": "{{username}}",
      "password": "{{password}}"
    }
  },
  "items": [
    {
      "info": {
        "name": "SMS",
        "type": "folder"
      },
      "items": [
        {
          "info": {
            "name": "Send an SMS Message",
            "type": "http"
          },
          "http": {
            "method": "POST",
            "url": "https://api.nexmo.com/sms/json",
            "body": {
              "type": "form-urlencoded",
              "data": [
                {
                  "name": "api_key",
                  "value": ""
                },
                {
                  "name": "api_secret",
                  "value": ""
                },
                {
                  "name": "to",
                  "value": ""
                },
                {
                  "name": "from",
                  "value": ""
                },
                {
                  "name": "text",
                  "value": ""
                },
                {
                  "name": "type",
                  "value": ""
                }
              ]
            }
          },
          "docs": "Send an outbound SMS from your Vonage number."
        }
      ]
    }
  ],
  "bundled": true
}