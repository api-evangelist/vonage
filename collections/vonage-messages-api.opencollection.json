{
  "opencollection": "1.0.0",
  "info": {
    "name": "Vonage Communications Applications Messages API",
    "version": "1.0.0"
  },
  "request": {
    "auth": {
      "type": "basic",
      "username": "{{username}}",
      "password": "{{password}}"
    }
  },
  "items": [
    {
      "info": {
        "name": "Messages",
        "type": "folder"
      },
      "items": [
        {
          "info": {
            "name": "Send a Message",
            "type": "http"
          },
          "http": {
            "method": "POST",
            "url": "https://api.nexmo.com/v1/messages",
            "body": {
              "type": "json",
              "data": "{}"
            },
            "auth": {
              "type": "bearer",
              "token": "{{bearerToken}}"
            }
          },
          "docs": "Send a message to a given channel (SMS, WhatsApp, Messenger, Viber, MMS, RCS)."
        },
        {
          "info": {
            "name": "Update a Message",
            "type": "http"
          },
          "http": {
            "method": "PATCH",
            "url": "https://api.nexmo.com/v1/messages/:message_uuid",
            "params": [
              {
                "name": "message_uuid",
                "value": "",
                "type": "path",
                "description": "The UUID of the message."
              }
            ],
            "body": {
              "type": "json",
              "data": "{}"
            },
            "auth": {
              "type": "bearer",
              "token": "{{bearerToken}}"
            }
          },
          "docs": "Update the status of a message (e.g., mark as read)."
        }
      ]
    }
  ],
  "bundled": true
}