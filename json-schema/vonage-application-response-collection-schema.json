                "active": {
                  "$ref": "#/$defs/active_webhook"
                }
              }
            },
            "captions_status": {
              "type": "object",
              "properties": {
                "address": {
                  "type": "string",
                  "description": "The URL that Vonage sends events when captions status changes"
                },
                "active": {
                  "$ref": "#/$defs/active_webhook"
                }
              }
            },
            "broadcast_status": {
              "type": "object",
              "properties": {
                "address": {
                  "type": "string",
                  "description": "The URL that Vonage sends events when a broadcast status changes"
                },
                "active": {
                  "$ref": "#/$defs/active_webhook"
                }
              }
            },
            "sip_call_created": {
              "type": "object",
              "properties": {
                "address": {
                  "type": "string",
